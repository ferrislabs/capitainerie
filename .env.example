DATABASE_URL=postgres://capitainerie:capitainerie@localhost:5442/capitainerie
SERVER_PORT=4100
ALLOWED_ORIGINS=http://localhost:4080
AUTH_AUDIENCE=http://localhost:4100
MCP_PORT=4101
LOG_FILTER=info,capitainerie=debug
# Unset to log to stderr only; set to export spans to Jaeger.
OTLP_ENDPOINT=http://localhost:4327
IGGY_ADDRESS=localhost:4190
IGGY_USERNAME=iggy
IGGY_PASSWORD=iggy
MCP_PUBLIC_URL=http://localhost:4101
MCP_AUDIENCE=capitainerie-mcp
MCP_ACCEPTED_AGENTS=capitainerie-agent-writer,capitainerie-agent-captain
# From ./scripts/bootstrap-ferriskey.sh (printed, never written).
EXCHANGE_CLIENT_ID=capitainerie-api
EXCHANGE_CLIENT_SECRET=
AGENT_CREDENTIALS=capitainerie-agent-writer=,capitainerie-agent-captain=
# openssl rand -base64 32 — the same for the API and the worker.
DELEGATION_KEY=
# openssl rand -base64 32 — distinct from DELEGATION_KEY; seals the providers' API keys. The API and the worker share it.
SECRETS_KEY=
# Each organization creates its own GitHub App from the console (Settings > Integrations > GitHub), so there is
# nothing to configure here but the hosts (for GitHub Enterprise) and where GitHub redirects the browser.
GITHUB_API_BASE=https://api.github.com
GITHUB_WEB_BASE=https://github.com
# The console as the browser reaches it: GitHub redirects the browser there; it never calls Capitainerie.
CONSOLE_URL=http://localhost:4080
PIPELINE_AGENTS=capitainerie-agent-writer
LLM_BASE_URL=http://localhost:4120/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=ollama
MCP_URL=http://localhost:4101/mcp
# Card vectors for deduplication: a local directory in dev.
LANCEDB_URI=./data/lancedb
EMBEDDING_MODEL=bge-m3
DEDUP_THRESHOLD=0.75
DEDUP_GRAY_FLOOR=0.65
ANALYTICS_URI=./data/analytics
ANALYTICS_FLUSH_EVENTS=500
ANALYTICS_FLUSH_SECS=30

# Odoo and n8n instances of the clients. Both false in production; true for an instance
# on localhost or a private network during development.
INTEGRATIONS_ALLOW_INSECURE_HTTP=false
INTEGRATIONS_ALLOW_PRIVATE_NETWORKS=false
