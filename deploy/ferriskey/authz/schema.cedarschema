namespace Capitainerie {
  type BaseContext = {
    organization: String,
    is_admin: Bool,
    actor_kind: String,
    actor?: String,
  };

  type CardUpdateContext = {
    organization: String,
    is_admin: Bool,
    actor_kind: String,
    actor?: String,
    intent: String,
    column?: String,
  };

  type CardMoveContext = {
    organization: String,
    is_admin: Bool,
    actor_kind: String,
    actor?: String,
    from: String,
    to: String,
  };

  type IntegrationCallContext = {
    organization: String,
    is_admin: Bool,
    actor_kind: String,
    actor?: String,
    access: String,
  };

  type McpCallContext = {
    organization: String,
    is_admin: Bool,
    actor_kind: String,
    actor?: String,
    initiated: Bool,
    granted: Bool,
  };

  entity Transcript, Transcription, Document, Run, Card, Provider, UserProvider, ModelAssignments, GithubInstallation, GithubApp, Client, Project, Member, Conversation, IntegrationInstance, Agent, McpConnector, Skill, Approval, Source, Routine, Audit, Budget, Inbox, Artifact = {
    organization: String,
  };

  action "capitainerie.any";

  action "transcript.create", "transcription.create", "document.read", "run.read", "card.create", "card.read", "card.comment", "provider.read", "provider.manage", "user_provider.manage", "models.assign", "card.execute", "github.manage", "client.read", "client.manage", "member.read", "github.read", "conversation.read", "conversation.write", "integration.read", "integration.manage", "card.intervene", "integration.revert", "agent.read", "agent.manage", "mcp_connector.manage", "mcp_connector.connect", "agent.run", "skill.read", "skill.manage", "approval.read", "approval.decide", "source.read", "source.manage", "routine.read", "routine.manage", "audit.read", "budget.manage", "inbox.read", "artifact.read" in ["capitainerie.any"] appliesTo {
    principal: [FerrisKey::User],
    resource: [Transcript, Transcription, Document, Run, Card, Provider, UserProvider, ModelAssignments, GithubInstallation, GithubApp, Client, Project, Member, Conversation, IntegrationInstance, Agent, McpConnector, Skill, Approval, Source, Routine, Audit, Budget, Inbox, Artifact],
    context: BaseContext,
  };

  action "card.update" in ["capitainerie.any"] appliesTo {
    principal: [FerrisKey::User],
    resource: [Transcript, Transcription, Document, Run, Card, Provider, UserProvider, ModelAssignments, GithubInstallation, GithubApp, Client, Project, Member, Conversation, IntegrationInstance, Agent, McpConnector, Skill, Approval, Source, Routine, Audit, Budget, Inbox, Artifact],
    context: CardUpdateContext,
  };

  action "card.move" in ["capitainerie.any"] appliesTo {
    principal: [FerrisKey::User],
    resource: [Transcript, Transcription, Document, Run, Card, Provider, UserProvider, ModelAssignments, GithubInstallation, GithubApp, Client, Project, Member, Conversation, IntegrationInstance, Agent, McpConnector, Skill, Approval, Source, Routine, Audit, Budget, Inbox, Artifact],
    context: CardMoveContext,
  };

  action "integration.call" in ["capitainerie.any"] appliesTo {
    principal: [FerrisKey::User],
    resource: [Transcript, Transcription, Document, Run, Card, Provider, UserProvider, ModelAssignments, GithubInstallation, GithubApp, Client, Project, Member, Conversation, IntegrationInstance, Agent, McpConnector, Skill, Approval, Source, Routine, Audit, Budget, Inbox, Artifact],
    context: IntegrationCallContext,
  };

  action "mcp.call" in ["capitainerie.any"] appliesTo {
    principal: [FerrisKey::User],
    resource: [Transcript, Transcription, Document, Run, Card, Provider, UserProvider, ModelAssignments, GithubInstallation, GithubApp, Client, Project, Member, Conversation, IntegrationInstance, Agent, McpConnector, Skill, Approval, Source, Routine, Audit, Budget, Inbox, Artifact],
    context: McpCallContext,
  };
