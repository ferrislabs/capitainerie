  "db_name": "PostgreSQL",
  "query": "\n            SELECT organization_id, agent_id, client_uuid, status, secret_nonce,\n                   secret_ciphertext, failure, synced, created_at, updated_at\n            FROM agent_identities\n            WHERE status = 'pending' AND (failure IS NULL OR updated_at < $1)\n            ORDER BY updated_at\n            LIMIT $2\n            ",
