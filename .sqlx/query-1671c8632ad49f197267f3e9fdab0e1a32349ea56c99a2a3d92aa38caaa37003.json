  "query": "\n            SELECT id, organization_id, routine_id, trigger_id, origin, scheduled_for,\n                   started_at, status, card_id, run_id, reason\n            FROM routine_runs\n            WHERE trigger_id = $1 AND status = 'queued'\n            ORDER BY started_at, id\n            LIMIT 1\n            ",
