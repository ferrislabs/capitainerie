  "query": "\n            SELECT id, organization_id, source_id, received_at, status,\n                   'null'::jsonb AS \"payload!\", summary, card_id, run_id, error\n            FROM source_events\n            WHERE organization_id = $1 AND source_id = $2\n            ORDER BY received_at DESC, id DESC\n            LIMIT $3 OFFSET $4\n            ",
