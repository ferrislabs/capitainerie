  "query": "\n            SELECT b.id, b.organization_id, b.agent_id, a.name AS \"agent_name?\",\n                   b.monthly_limit_cents, b.alert_threshold_percent, b.updated_by, b.updated_at\n            FROM budgets b\n            LEFT JOIN agents a ON a.id = b.agent_id\n            WHERE b.organization_id = $1\n            ",
